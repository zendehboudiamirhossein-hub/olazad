# AzadGram Panel Environment Variables (PRODUCTION)
# Copy to .env (dev) or set in Railway Variables (production)
# NEVER commit secrets to git.

# Database URL — Railway sets this automatically when you add PostgreSQL.
# For local dev, you can use SQLite:
DATABASE_URL=file:/home/z/my-project/db/custom.db

# === Required secrets (>= 32 bytes, random) ===
# Generate with: openssl rand -hex 32
JWT_SECRET=<replace-with-64-char-hex>
CLIENT_API_SECRET=<replace-with-different-64-char-hex>

# === Admin bootstrap ===
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
DISABLE_SEED=1   # always 1 in production — seeding is via scripts/create-admin.ts

# === Optional: Telegram bot for client verification ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=AzadGramBot
BOT_VERIFICATION_ENABLED=true

# === Allowed release download domains (CSV) ===
# Only these domains will be accepted for AppRelease.downloadUrl
ALLOWED_RELEASE_DOMAINS=github.com,githubusercontent.com,backblaze.com
